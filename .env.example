# Set these in Railway → Service → Variables (do NOT commit real values)

# Required in production — WebSocket bridge shared secret.
# Generate one: openssl rand -hex 32
OMNIROUTE_WS_BRIDGE_SECRET=change-me-to-a-long-random-string

# Your public Railway domain — used for OAuth callbacks + dashboard links.
NEXT_PUBLIC_BASE_URL=https://your-service-name.up.railway.app

# Optional: skip Redis entirely. Single-instance deployments fall back
# to an in-memory rate limiter/cache automatically. Leave unset unless
# you attach a Redis plugin and want distributed state.
# REDIS_URL=

# Optional tuning:
# OMNIROUTE_MEMORY_MB=256        # lower heap on Hobby plan
# DISABLE_SQLITE_AUTO_BACKUP=true # only if backups are handled externally
